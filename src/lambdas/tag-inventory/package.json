{
    "name": "tag-inventory-lambda",
    "version": "1.0.0",
    "description": "AWS Tag Inventory Lambda Function",
    "main": "index.js",
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && esbuild index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --external:@aws-sdk/*",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@aws-sdk/client-account": "^3.980.0",
        "@aws-sdk/client-cloudwatch": "^3.974.0",
        "@aws-sdk/client-ec2": "^3.974.0",
        "@aws-sdk/client-resource-groups-tagging-api": "^3.974.0",
        "@aws-sdk/client-s3": "^3.974.0",
        "esbuild": "^0.27.2",
        "rimraf": "^5.0.10"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.130",
        "@types/node": "^22.0.0",
        "typescript": "^5.9.3"
    }
}
